rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in [
          'jakenelsonfernandez@gmail.com',
          'sjthai37@gmail.com'
        ];
    }
  }
}
